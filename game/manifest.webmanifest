{
  "name": "Neon Somnia",
  "short_name": "Neon Somnia",
  "description": "A surreal cyberpunk first-person shooter for your phone's browser.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#0b0214",
